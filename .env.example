AIRTABLE_TOKEN=
# Signs session + pre-auth JWTs (HS256). Required, >= 32 random characters: openssl rand -base64 48
SESSION_SECRET=
# AES-256-GCM key for MFA secrets: 32 random bytes, base64 (openssl rand -base64 32)
MFA_ENC_KEY=
# Google SSO (OIDC code flow + PKCE). Create an OAuth "Web application" client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of this app, no path (https required except localhost), e.g. https://kep.example.org.
# The redirect URI is derived as <GOOGLE_REDIRECT_BASE>/api/auth/google/callback: register EXACTLY that
# URL under "Authorized redirect URIs". All post-login redirects also use this origin (no open redirect).
GOOGLE_REDIRECT_BASE=
# Email (invites, password reset) via Resend, behind src/lib/email. Without RESEND_API_KEY nothing is sent (a warning is logged).
# IMPORTANT: keep Resend click/open tracking OFF for the sending domain, otherwise the one-time link (incl. its token) is stored by the tracking redirect.
RESEND_API_KEY=
# From address; must be on a domain verified in Resend. Default: KEP Keuskupan Bandung <onboarding@resend.dev>
MAIL_FROM=
# Public origin used in emailed links (https, no path), e.g. https://kep.example.org. Falls back to GOOGLE_REDIRECT_BASE.
# Invite links last 72 h, reset links 30 min; both are single use (bound to the account's current password hash).
APP_BASE_URL=
TURNSTILE_SECRET=
# Rate limiter (src/lib/ratelimit.ts). Required in production: without both, an in-memory per-process fallback is used.
# If configured and Upstash errors, auth routes fail CLOSED (429).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REG_TOKEN_SECRET=
