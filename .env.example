# Production config gate: src/lib/config/prodEnv.ts lists what is required; missing/invalid -> 503 + names in the log.
# Airtable PAT with ONLY data.records:read + data.records:write, restricted to base BPK Bandung (docs/ops/runbook.md).
AIRTABLE_TOKEN=
# Local fake Airtable only (tests/e2e). Ignored/refused in production.
# AIRTABLE_API_URL=
# Signs session + pre-auth JWTs (HS256). Required, >= 32 random characters: openssl rand -base64 48
SESSION_SECRET=
# AES-256-GCM key for MFA secrets: 32 random bytes, base64 (openssl rand -base64 32)
MFA_ENC_KEY=
# Google SSO (OIDC code flow + PKCE). Create an OAuth "Web application" client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of this app, no path (https required except localhost), e.g. https://kep.example.org.
# The redirect URI is derived as <GOOGLE_REDIRECT_BASE>/api/auth/google/callback: register EXACTLY that
# URL under "Authorized redirect URIs". All post-login redirects also use this origin (no open redirect).
GOOGLE_REDIRECT_BASE=
# Email (invites, password reset) via Resend, behind src/lib/email. Without RESEND_API_KEY nothing is sent (a warning is logged).
# IMPORTANT: keep Resend click/open tracking OFF for the sending domain, otherwise the one-time link (incl. its token) is stored by the tracking redirect.
RESEND_API_KEY=
# From address; must be on a domain verified in Resend. Default: KEP Keuskupan Bandung <onboarding@resend.dev>
MAIL_FROM=
# Public origin used in emailed links (https, no path), e.g. https://kep.example.org. Falls back to GOOGLE_REDIRECT_BASE.
# Invite links last 72 h, reset links 30 min; both are single use (bound to the account's current password hash).
APP_BASE_URL=
# Cloudflare Turnstile (public registration form). SECRET: server-side verification, fails closed when empty.
# SITE_KEY: public widget key (the widget loads from challenges.cloudflare.com, already allowed by the CSP).
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
# Minimum response time (ms) of the public registration POST, evens out registered / already_registered timing. Default 2500.
# REG_MIN_RESPONSE_MS=6000
# Rate limiter + session denylist (src/lib/ratelimit.ts). REQUIRED in production: without both the app answers 503
# (src/proxy.ts) and never uses per-process memory. Dev/test fall back to memory. Upstash errors fail CLOSED
# (limits 429, every session treated as logged out 401). See docs/ops/runbook.md.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# HMAC-SHA256 key for public registration links /daftar/<token> (token = Events record id + version, no personal data).
# REQUIRED, >= 32 bytes: openssl rand -base64 48. Rotating it invalidates every issued link.
REG_TOKEN_SECRET=
# Attendance tuning (optional): re-check delay for concurrent writes, and the time budget of "tandai semua".
# ABSEN_RECHECK_MS=400
# ABSEN_SEMUA_BUDGET_MS=45000
# NEVER set on a real server: lets the Playwright production build use the fake Airtable / memory store (ignored on Vercel).
# KEP_E2E_MODE=
